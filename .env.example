# ============================================================
# Bike-Line-Bot 環境変数 雛形
# 本番は .env にコピーして実値を設定してください（.env は Git 管理外）
# 実際の秘密情報をこのファイルに書かないでください
# ============================================================

# --- Django 基本 ---
# 本番では必ず安全なランダム値に変更する
DJANGO_SECRET_KEY=changeme-replace-with-secure-random-string
# 本番では False にする
DEBUG=True
# 公開ドメイン（カンマ区切り）。本番は example.com 等を指定
ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS 公開ドメイン（カンマ区切り、例: https://example.com）
CSRF_TRUSTED_ORIGINS=

# --- MySQL ---
MYSQL_DATABASE=bike_line_bot
MYSQL_USER=bike_line_bot
MYSQL_PASSWORD=changeme
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# docker-compose の db コンテナ用（開発/本番どちらでも設定）
MYSQL_ROOT_PASSWORD=root_password

# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=changeme
LINE_CHANNEL_ACCESS_TOKEN=changeme
# 引き継ぎ通知を送るスタッフの LINE ユーザーID（カンマ区切り）
STAFF_LINE_USER_IDS=

# --- AI (OpenAI) ---
OPENAI_API_KEY=changeme
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_TEMPERATURE=0

# --- レート制限 ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60

# --- HTTPS / セキュリティ（本番は True に） ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- ログ ---
LOG_LEVEL=INFO

# --- gunicorn（コンテナ利用時のみ。必要なければ省略可） ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=60
GUNICORN_LOGLEVEL=info
